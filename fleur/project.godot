; Engine configuration file.
config_version=5

[application]

config/name="Послевкусие"
config/description="Послевкусие: жизнь Шевалье де ла Флёра в Кур-де-Фонтейне. Фанатский проект по миру Genshin Impact."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Content="*res://core/content.gd"
Rules="*res://core/rules.gd"
Sound="*res://core/sound.gd"
Game="*res://core/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

timers/tooltip_delay_sec=0.35

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
